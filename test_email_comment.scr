#!/bin/bash
#SBATCH --job-name=test_email
#SBATCH --output=test_email.out
#SBATCH --error=test_email.err
#SBATCH -p uri-cpu
#SBATCH -c 1
#SBATCH --mem=100M
#SBATCH -t 00:01:00
#SBATCH --mail-user=arash_rafiee@uri.edu
#SBATCH --mail-type=END

track="center"
RICHAMP_OUTDIR="/scratch4/workspace/arash_rafiee_uri_edu-richamp/RICHAMP"

scontrol update JobId=$SLURM_JOBID Comment="Track: ${track} | Files ready at: ${RICHAMP_OUTDIR}"

echo "Test job done at $(date)"
